# Copy to a secret store or a process environment. Do not commit a real .env.
# Generate a gateway token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The process refuses the placeholder below and any token shorter than 32 characters.

# Gateway only (wrkhorse serve and wrkhorse mcp-stdio). Not read by the worker.
WRKHORSE_AUTH_TOKEN=replace-with-a-random-token-at-least-32-chars

# Shared by the gateway process and the worker process on the SAME machine.
# Use an absolute path. On a Runpod pod volume this should live under /workspace.
WRKHORSE_DB=var/wrkhorse.sqlite

# HTTP gateway bind. Loopback is the default. Public bind also needs the two lines below.
WRKHORSE_HOST=127.0.0.1
WRKHORSE_PORT=8765
# WRKHORSE_ALLOW_PUBLIC_BIND=1
# WRKHORSE_PUBLIC_HOST=YOUR_POD_ID-8765.proxy.runpod.net

# Worker only. Default refuses code execution and does not call a model.
# trusted-local-demo is an explicit opt-in for a disposable machine: it runs the
# reviewed sample fixture and may request a diff. It is not a sandbox, and it
# does not execute model-written code.
# WRKHORSE_EXECUTION_MODE=disabled

# Worker only. Separate from WRKHORSE_AUTH_TOKEN. Never commit a real key.
# WRKHORSE_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
# WRKHORSE_INFERENCE_API_KEY=replace-with-the-vllm-api-key
# WRKHORSE_INFERENCE_MODEL=your-org/your-model-id

# Recommended home Mac deployment. scripts/start-home.sh reads WRKHORSE_* lines
# from a gitignored .env in the repo root (never the auth token; that lives in
# var/mcp-token) and forces the safety settings itself:
# WRKHORSE_EXECUTION_MODE=inference-only
# WRKHORSE_MODEL_CHAT_ENABLED=1  # expose bounded text-only ask_local_model on MCP
# WRKHORSE_MODEL_CHAT_TIMEOUT_SECONDS=120
# WRKHORSE_INFERENCE_API_KEY=ollama-local  # ignored by Ollama, not a real secret
#
# Model choice. Ollama cloud tags (name:cloud, name:120b-cloud) are refused.
# WRKHORSE_INFERENCE_MODEL=qwen2.5-coder:1.5b
# Reasoning models (qwen3, deepseek-r1, gpt-oss) need more output tokens:
# WRKHORSE_INFERENCE_MAX_TOKENS=4096
# WRKHORSE_INFERENCE_TIMEOUT_SECONDS=180
#
# Where the model runs. Any OpenAI-compatible server on THIS machine works:
# WRKHORSE_INFERENCE_BASE_URL=http://127.0.0.1:11434/v1   # Ollama (default)
# WRKHORSE_INFERENCE_BASE_URL=http://127.0.0.1:1234/v1    # LM Studio
# WRKHORSE_INFERENCE_BASE_URL=http://127.0.0.1:8080/v1    # llama.cpp / mlx_lm.server
#
# A model on ANOTHER machine you control needs an explicit opt-in and a
# private address: 10/8, 172.16/12, 192.168/16, Tailscale 100.64/10, IPv6 ULA,
# or a hostname ending .local/.lan/.home.arpa/.internal/.ts.net that resolves
# only to such addresses. Public and link-local addresses are always refused.
# WRKHORSE_ALLOW_LAN_MODEL=1
# WRKHORSE_INFERENCE_BASE_URL=http://studio.local:11434/v1
# WRKHORSE_INFERENCE_BASE_URL=http://gpu-box.your-tailnet.ts.net:11434/v1

# OPTIONAL secured named Cloudflare Tunnel + Access Managed OAuth:
# When these 3 settings are provided, the gateway requires a cryptographically
# verified Cf-Access-Jwt-Assertion for every HTTP MCP request; the local
# bearer token is NOT an alternative in Access mode.
# WRKHORSE_PUBLIC_HOST=agent.example.com
# WRKHORSE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# WRKHORSE_ACCESS_AUDIENCE=your-cloudflare-access-application-aud-tag
# Keep Ollama bound to 127.0.0.1 and protect this hostname with an Access policy.

# OPTIONAL Pi-inspired GitHub draft-post tools for authenticated MCP clients.
# Disabled by default. Set these ONLY in your private, gitignored .env or
# a secret manager on the Mac (never put a real token into this example).
#
# WRKHORSE_GITHUB_DRAFTS_ENABLED=1
# WRKHORSE_GITHUB_DRAFT_REPO=OWNER/PRIVATE_CONTENT_REPO
# WRKHORSE_GITHUB_TOKEN=replace-with-one-repo-fine-grained-pat
#
# The scoped credential needs Contents: read/write and Pull requests: read/write
# for ONE repo. Tools only read/write posts/drafts/<slug>.md. New writes make
# a branch and DRAFT PR; edits require exact unique old_text and still-open PR.
# No merge, delete, publish or direct main write tool.
# Reminder: a draft PR in a public repo is PUBLICLY visible.

# OPTIONAL model router. Defaults to auto; WITHOUT cloud opt-in everything
# stays on the existing local Ollama backend.
# WRKHORSE_MODEL_ROUTING=auto   # auto | local | cloud
# To route bounded coding inference through a rented GPU, first establish
# a private SSH tunnel to its loopback-bound Ollama API. No GPU is started here.
# WRKHORSE_CLOUD_INFERENCE_ENABLED=1
# WRKHORSE_CLOUD_INFERENCE_BASE_URL=http://127.0.0.1:11435/v1
# WRKHORSE_CLOUD_INFERENCE_MODEL=your-remote-coding-model
# See docs/MODEL-ROUTER.md for behavior, limitations, and safety checks.
